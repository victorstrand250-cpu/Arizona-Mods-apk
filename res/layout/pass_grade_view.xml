<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="wrap_content"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/imageView5"
        android:layout_width="wrap_content"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline8"
        app:srcCompat="@drawable/vertical_line" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/premium_award_image"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginTop="8.0dip"
        android:layout_marginStart="8.0dip"
        android:layout_marginEnd="8.0dip"
        app:layout_constraintBottom_toTopOf="@id/premium_award_title"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline10"
        app:srcCompat="@drawable/daemon_mask" />
    <TextView
        android:id="@id/premium_award_title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.0dip"
        android:text="Маска Димона"
        app:layout_constraintBottom_toTopOf="@id/guideline12"
        app:layout_constraintEnd_toEndOf="@id/premium_award_image"
        app:layout_constraintStart_toStartOf="@id/premium_award_image"
        style="@style/small_2line_text" />
    <TextView
        android:textSize="@dimen/_6sdp"
        android:textColor="#80ffffff"
        android:id="@id/grade_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/gotham"
        app:layout_constraintBottom_toTopOf="@id/guideline8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.504"
        app:layout_constraintStart_toStartOf="parent" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/standard_award_image"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginTop="8.0dip"
        android:layout_marginStart="4.0dip"
        android:layout_marginEnd="4.0dip"
        app:layout_constraintBottom_toTopOf="@id/standard_award_title"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline7"
        app:srcCompat="@drawable/daemon_mask" />
    <TextView
        android:id="@id/standard_award_title"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8.0dip"
        android:text="Маска Димона"
        app:layout_constraintBottom_toTopOf="@id/guideline9"
        app:layout_constraintEnd_toEndOf="@id/standard_award_image"
        app:layout_constraintStart_toStartOf="@id/standard_award_image"
        style="@style/small_2line_text" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@id/guideline7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.1" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@id/guideline9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.45" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@id/guideline10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.55" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@id/guideline12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@id/guideline8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.06" />
    <TextView
        android:textSize="@dimen/_6sdp"
        android:typeface="sans"
        android:textColor="@color/white"
        android:id="@id/award_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 Coins"
        android:fontFamily="@font/gotham"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@id/guideline10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline9" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/receive_arrow"
        android:layout_width="0.0dip"
        android:layout_height="10.0dip"
        app:layout_constraintBottom_toTopOf="@id/guideline10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline9"
        app:srcCompat="@drawable/check_mark" />
    <Button
        android:textSize="@dimen/_6sdp"
        android:textColor="@color/black"
        android:id="@id/claimTop"
        android:padding="2.0dip"
        android:paddingLeft="2.0dip"
        android:paddingTop="2.0dip"
        android:paddingRight="2.0dip"
        android:paddingBottom="2.0dip"
        android:visibility="gone"
        android:layout_width="50.0dip"
        android:layout_height="30.0dip"
        android:text="Забрать"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:backgroundTint="@color/battle_pass_2022_green"
        app:iconPadding="0.0dip"
        app:layout_constraintBottom_toTopOf="@id/standard_award_title"
        app:layout_constraintEnd_toEndOf="@id/standard_award_image"
        app:layout_constraintStart_toStartOf="@id/standard_award_image"
        app:layout_constraintTop_toTopOf="@id/standard_award_image" />
    <Button
        android:textSize="@dimen/_6sdp"
        android:textColor="@color/black"
        android:id="@id/claimBottom"
        android:paddingLeft="2.0dip"
        android:paddingTop="2.0dip"
        android:paddingRight="2.0dip"
        android:paddingBottom="2.0dip"
        android:layout_width="50.0dip"
        android:layout_height="30.0dip"
        android:text="Забрать"
        android:textAllCaps="false"
        android:layout_marginStart="8.0dip"
        android:layout_marginEnd="8.0dip"
        android:backgroundTint="@color/battle_pass_2022_green"
        app:layout_constraintBottom_toBottomOf="@id/premium_award_image"
        app:layout_constraintEnd_toEndOf="@id/premium_award_image"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="@id/premium_award_image"
        app:layout_constraintTop_toTopOf="@id/premium_award_image" />
    <LinearLayout
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toTopOf="@id/guideline10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline9">
        <View
            android:id="@id/progress_bar"
            android:background="#80ffcb5a"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0" />
        <Space
            android:id="@id/progress_space"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            android:layout_weight="1.0" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>