<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/registration_ped_settings"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/registration_ped_settings_background"
        android:layout_width="350.0dip"
        android:layout_height="fill_parent"
        app:layout_constraintLeft_toLeftOf="parent">
        <ImageView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:src="@drawable/authorization_bg"
            android:scaleType="fitXY" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/registration_ped_shadow_settings_ped"
            android:layout_width="480.0dip"
            android:layout_height="240.0dip"
            android:src="@drawable/ped_settings_shadow_bg"
            android:elevation="2.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />
        <TextView
            android:textSize="20.0dip"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:id="@id/registration_ped_settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35.0dip"
            android:text="@string/customize_character"
            android:fontFamily="@font/pfdregular"
            android:textFontWeight="500"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/registration_ped_settings_container"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="20.0dip"
            android:elevation="3.0dip"
            app:layout_constraintLeft_toLeftOf="@id/registration_ped_start_game_button"
            app:layout_constraintRight_toRightOf="@id/registration_ped_start_game_button"
            app:layout_constraintTop_toBottomOf="@id/registration_ped_settings_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/registration_ped_gender_container"
                android:background="@drawable/authorization_border"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginTop="10.0dip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/registration_ped_men_container"
                    android:background="@drawable/registration_selected_border"
                    android:layout_width="0.0dip"
                    android:layout_height="32.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/registration_ped_women_container"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.47">
                    <TextView
                        android:textSize="15.0dip"
                        android:textColor="@color/white"
                        android:id="@id/registration_ped_men_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/male"
                        android:fontFamily="@font/pfdregular"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/registration_ped_women_container"
                    android:background="@color/ap_transparent"
                    android:layout_width="0.0dip"
                    android:layout_height="32.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/registration_ped_men_container"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.47">
                    <TextView
                        android:textSize="15.0dip"
                        android:textColor="@color/white"
                        android:id="@id/registration_ped_women_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/female"
                        android:fontFamily="@font/pfdregular"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/registration_ped_skin_container"
                android:background="@drawable/authorization_border"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginTop="10.0dip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/registration_ped_gender_container">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/registration_ped_skin_white_container"
                    android:background="@color/ap_transparent"
                    android:layout_width="0.0dip"
                    android:layout_height="32.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toLeftOf="@id/registration_ped_skin_black_container"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.47">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/registration_ped_skin_white_image"
                        android:layout_width="14.0dip"
                        android:layout_height="14.0dip"
                        android:src="@drawable/white_skin_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/registration_ped_skin_black_container"
                    android:background="@drawable/registration_selected_border"
                    android:layout_width="0.0dip"
                    android:layout_height="32.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/registration_ped_skin_white_container"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_percent="0.47">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/registration_ped_skin_black_image"
                        android:layout_width="14.0dip"
                        android:layout_height="14.0dip"
                        android:src="@drawable/black_skin_icon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/registration_ped_clothes_container"
                android:background="@drawable/authorization_border"
                android:layout_width="fill_parent"
                android:layout_height="40.0dip"
                android:layout_marginTop="10.0dip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/registration_ped_skin_container">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/registration_ped_clothes_left_button"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:layout_marginLeft="15.0dip"
                    android:src="@drawable/arrow_right_ic"
                    android:rotation="180.0"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:textSize="15.0dip"
                    android:textColor="@color/white"
                    android:id="@id/registration_ped_clothes_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/male_1"
                    android:fontFamily="@font/pfdregular"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/registration_ped_clothes_right_button"
                    android:layout_width="25.0dip"
                    android:layout_height="25.0dip"
                    android:layout_marginRight="15.0dip"
                    android:src="@drawable/arrow_right_ic"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/registration_ped_start_game_button"
            android:background="@drawable/authorization_border_red"
            android:layout_width="275.0dip"
            android:layout_height="40.0dip"
            android:layout_marginTop="25.0dip"
            android:elevation="4.0dip"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/registration_ped_settings_container">
            <TextView
                android:textSize="16.0dip"
                android:textColor="@color/white"
                android:id="@id/registration_ped_start_game_button_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6.0dip"
                android:text="@string/start_game"
                android:fontFamily="@font/heading_now_64_regular"
                android:textFontWeight="400"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>