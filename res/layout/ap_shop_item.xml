<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/imageView13"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_margin="2.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/item_image"
        app:layout_constraintStart_toStartOf="@id/item_image"
        app:layout_constraintTop_toTopOf="@id/item_image"
        app:srcCompat="@drawable/arizona_pass_shop_item_frame" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/item_image"
        android:padding="8.0dip"
        android:layout_width="120.0dip"
        android:layout_height="120.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/daemon_mask" />
    <TextView
        android:textSize="@dimen/_11sdp"
        android:textColor="@color/white"
        android:id="@id/item_name"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:fontFamily="@font/pfdregular"
        android:layout_marginStart="8.0dip"
        android:layout_marginEnd="8.0dip"
        app:layout_constraintEnd_toEndOf="@id/item_image"
        app:layout_constraintStart_toStartOf="@id/item_image"
        app:layout_constraintTop_toBottomOf="@id/item_image" />
    <TextView
        android:textSize="@dimen/_11sdp"
        android:textColor="#ffffcb5a"
        android:id="@id/item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:layout_marginBottom="8.0dip"
        android:fontFamily="@font/heading_now_64_regular"
        app:layout_constraintBottom_toBottomOf="@id/imageView13"
        app:layout_constraintStart_toStartOf="@id/item_name"
        app:layout_constraintTop_toBottomOf="@id/item_name" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/imageView21"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="4.0dip"
        app:layout_constraintBottom_toBottomOf="@id/item_price"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toEndOf="@id/item_price"
        app:layout_constraintTop_toTopOf="@id/item_price"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/pc" />
    <androidx.constraintlayout.widget.Group
        android:id="@id/group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="buy_button,imageView22" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/imageView22"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@id/imageView13"
        app:layout_constraintEnd_toEndOf="@id/imageView13"
        app:layout_constraintStart_toStartOf="@id/imageView13"
        app:layout_constraintTop_toTopOf="@id/imageView13"
        app:srcCompat="@drawable/shop_item_select_bg" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/buy_button"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="16.0dip"
        android:layout_marginEnd="16.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/imageView13"
        app:layout_constraintStart_toStartOf="@id/imageView13"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/shop_item_buy_button" />
</androidx.constraintlayout.widget.ConstraintLayout>