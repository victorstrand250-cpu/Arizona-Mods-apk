<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/rodina_quest_awards_item"
    android:background="@drawable/rodina_quest_normal_background"
    android:layout_width="@dimen/_44sdp"
    android:layout_height="wrap_content"
    android:layout_marginRight="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/rodina_quest_awards_image"
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:src="@drawable/item_template"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:textSize="@dimen/_6sdp"
        android:textStyle="normal"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@id/rodina_quest_info_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4.0dip"
        android:text="₽ 100 млн."
        android:fontFamily="@font/gotham"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rodina_quest_awards_image" />
</androidx.constraintlayout.widget.ConstraintLayout>