                    android:layout_width="80.0dip"
                    android:layout_height="10.0dip"
                    android:max="100"
                    android:progress="65"
                    android:progressTint="#ffef9f52"
                    android:progressBackgroundTint="#ffc56c4b"
                    style="?android:progressBarStyleHorizontal" />
            </LinearLayout>
        </LinearLayout>
