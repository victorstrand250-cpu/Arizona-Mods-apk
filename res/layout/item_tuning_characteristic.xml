<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/parentLayout"
    android:paddingBottom="2.0dip"
    android:layout_width="@dimen/_80sdp"
    android:layout_height="wrap_content"
    android:layout_marginStart="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/mainView"
        android:background="@drawable/btn_border_tuning"
        android:layout_width="@dimen/_80sdp"
        android:layout_height="@dimen/_80sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@id/clickedBg"
            android:background="@drawable/btn_border_tuning_gray"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:backgroundTint="@color/rodina_gray" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_7sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@id/tvItemType"
            android:background="@drawable/border_radius_5"
            android:paddingTop="2.0dip"
            android:paddingBottom="2.0dip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/pfdindisplaypro_italic"
            android:paddingStart="6.0dip"
            android:paddingEnd="6.0dip"
            android:layout_marginStart="@dimen/_4sdp"
            android:backgroundTint="@color/red"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_7sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@id/tvItemDiscount"
            android:background="@color/red"
            android:padding="2.0dip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/pfdindisplaypro_italic"
            android:layout_marginEnd="@dimen/_2sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <ImageView
            android:id="@id/ivItemIcon"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:alpha="0.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_7sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/tvItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:fontFamily="@font/pfdindisplaypro_light"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivItemIcon" />
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/_8sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/tvItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:drawablePadding="4.0dip"
            android:drawableStart="@drawable/ic_dollar_green"
            android:fontFamily="@font/pfdindisplaypro_light"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvItemName" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:textSize="@dimen/_6sdp"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@id/btnCartTypes"
        android:background="@drawable/border_radius_5"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_4sdp"
        android:textAllCaps="false"
        android:backgroundTint="@color/green_type3"
        app:layout_constraintEnd_toEndOf="@id/mainView"
        app:layout_constraintStart_toStartOf="@id/mainView"
        app:layout_constraintTop_toBottomOf="@id/mainView" />
</androidx.constraintlayout.widget.ConstraintLayout>