<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mp_uber_chose_taxi_page"
    android:layout_width="160.0dip"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/mp_uber_header"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8.0dip"
        android:layout_marginTop="16.0dip"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/mp_uber_header_back"
            android:layout_width="12.0dip"
            android:layout_height="12.0dip"
            android:src="@drawable/ic_arrow"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="10.0dip"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@id/mp_uber_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Arizona Uber"
            android:fontFamily="@font/gotham"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/mp_uber_location_container"
        android:layout_width="152.0dip"
        android:layout_height="45.0dip"
        android:layout_marginTop="50.0dip"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mp_uber_header">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/mp_uber_my_location_container"
            android:background="@drawable/border_radius"
            android:layout_width="fill_parent"
            android:layout_height="20.0dip"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="8.0dip"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@id/mp_uber_my_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Моя геолокация"
                android:fontFamily="@font/gotham"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@color/black"
            android:layout_width="2.0dip"
            android:layout_height="4.0dip"
            app:layout_constraintBottom_toTopOf="@id/mp_uber_final_location_container"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mp_uber_my_location_container" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/mp_uber_final_location_container"
            android:background="@drawable/border_radius"
            android:layout_width="fill_parent"
            android:layout_height="20.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <TextView
                android:textSize="8.0dip"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/mp_uber_final_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Выбрать пункт назначения"
                android:fontFamily="@font/gotham"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="10.0dip"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@id/mp_uber_chose_priority_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:text="Выберите класс"
        android:fontFamily="@font/gotham"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mp_uber_location_container" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/mp_uber_chose_priority"
        android:layout_width="144.0dip"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6.0dip"
        android:layout_marginTop="8.0dip"
        android:layout_marginEnd="6.0dip"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mp_uber_chose_priority_text">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@id/mp_uber_chose_priority_list"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="20.0dip"
            android:layout_width="fill_parent"
            android:layout_height="40.0dip"
            android:requiresFadingEdge="horizontal"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:spanCount="1" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/mp_uber_action_button"
        android:background="@drawable/border_radius"
        android:layout_width="144.0dip"
        android:layout_height="28.0dip"
        android:layout_marginTop="6.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mp_uber_chose_priority">
        <TextView
            android:textSize="10.0dip"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/mp_uber_action_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вызвать такси"
            android:fontFamily="@font/gotham"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>