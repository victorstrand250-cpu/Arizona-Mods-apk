<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/transparent100"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="@dimen/_14sdp"
        android:textStyle="italic"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@id/tvTitle"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:text="@string/fixing"
        android:textAllCaps="true"
        android:fontFamily="@font/pfdbold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:textSize="@dimen/_8sdp"
        android:textColor="@color/grey_type2"
        android:gravity="center"
        android:id="@id/tvTitleDescription"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="10.0dip"
        android:text="Перенесите предмет и камень заточки в необходимые ячейки."
        android:fontFamily="@font/pfdregular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />
    <include
        android:id="@id/leftItemField"
        android:visibility="invisible"
        android:layout_width="76.0dip"
        android:layout_height="76.0dip"
        android:layout_marginTop="42.0dip"
        app:layout_constraintEnd_toStartOf="@id/mainItemField"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitleDescription"
        layout="@layout/item_inventory" />
    <include
        android:id="@id/mainItemField"
        android:layout_width="120.0dip"
        android:layout_height="120.0dip"
        android:layout_marginTop="20.0dip"
        android:layout_marginStart="30.0dip"
        app:layout_constraintEnd_toStartOf="@id/rightItemField"
        app:layout_constraintStart_toEndOf="@id/leftItemField"
        app:layout_constraintTop_toBottomOf="@id/tvTitleDescription"
        layout="@layout/item_workshop" />
    <TextView
        android:textSize="@dimen/_8sdp"
        android:textStyle="italic"
        android:textColor="@color/grey_type2"
        android:gravity="center"
        android:id="@id/tvMainItemDescription"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:text="@string/item"
        android:textAllCaps="true"
        android:fontFamily="@font/pfdregular"
        app:layout_constraintEnd_toEndOf="@id/mainItemField"
        app:layout_constraintStart_toStartOf="@id/mainItemField"
        app:layout_constraintTop_toBottomOf="@id/mainItemField" />
    <include
        android:id="@id/rightItemField"
        android:visibility="invisible"
        android:layout_width="76.0dip"
        android:layout_height="76.0dip"
        android:layout_marginTop="42.0dip"
        android:layout_marginStart="30.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/mainItemField"
        app:layout_constraintTop_toBottomOf="@id/tvTitleDescription"
        layout="@layout/item_inventory" />
    <ProgressBar
        android:id="@id/progressBar"
        android:background="@drawable/rectangle_bar"
        android:layout_width="280.0dip"
        android:layout_height="16.0dip"
        android:layout_marginTop="40.0dip"
        android:max="100"
        android:progress="0"
        android:indeterminate="false"
        android:progressDrawable="@drawable/yellow_progressbar"
        android:progressTint="@color/yellow_type1"
        app:layout_constraintBottom_toTopOf="@id/infoLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMainItemDescription"
        style="?android:progressBarStyleHorizontal" />
    <LinearLayout
        android:id="@id/infoLayout"
        android:layout_width="0.0dip"
        android:layout_height="32.0dip"
        android:layout_marginTop="24.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progressBar">
        <include
            android:id="@id/costFieldPainting"
            android:layout_width="0.0dip"
            android:layout_height="30.0dip"
            android:layout_weight="1.0"
            android:layout_marginStart="4.0dip"
            app:layout_constraintBottom_toTopOf="@id/guidelineHor2"
            app:layout_constraintEnd_toStartOf="@id/btnFixItem"
            app:layout_constraintStart_toEndOf="@id/guidelineVer1"
            layout="@layout/item_info_cost" />
        <Button
            android:textSize="@dimen/_9sdp"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:id="@id/btnFixItem"
            android:background="@drawable/bg_success_chance_test"
            android:layout_width="0.0dip"
            android:layout_height="30.0dip"
            android:text="починить"
            android:layout_weight="1.0"
            android:fontFamily="@font/pfdregular"
            android:layout_marginStart="4.0dip"
            app:layout_constraintBottom_toTopOf="@id/guidelineHor2"
            app:layout_constraintEnd_toEndOf="@id/guidelineVer2"
            app:layout_constraintStart_toEndOf="@id/costFieldPainting" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>