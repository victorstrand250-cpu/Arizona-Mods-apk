<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/messanger_main_page"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:gravity="start|center"
        android:id="@id/header_container"
        android:visibility="visible"
        android:layout_width="fill_parent"
        android:layout_height="40.0dip"
        android:layout_marginLeft="10.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginRight="10.0dip"
        android:layout_marginHorizontal="10.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@id/header_back"
            android:padding="1.0dip"
            android:layout_width="15.0dip"
            android:layout_height="15.0dip"
            android:src="@drawable/ic_left_arrow_phone" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3.0dip">
            <com.arizona.common.ui.AvatarView
                android:layout_gravity="center"
                android:id="@id/avatar"
                android:layout_width="30.0dip"
                android:layout_height="30.0dip" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4.0dip">
                <LinearLayout
                    android:gravity="start|center"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/ic_attach"
                        android:visibility="gone"
                        android:layout_width="8.0dip"
                        android:layout_height="8.0dip"
                        android:src="@drawable/ic_paperclip"
                        android:layout_marginEnd="3.0dip" />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textSize="8.0sp"
                        android:textColor="#ffffffff"
                        android:ellipsize="end"
                        android:id="@id/contact_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="60.0dip"
                        android:maxLines="1" />
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@id/ic_notification_off"
                        android:visibility="gone"
                        android:layout_width="8.0dip"
                        android:layout_height="8.0dip"
                        android:src="@drawable/ic_notification_off"
                        android:layout_marginStart="2.0dip" />
                </LinearLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="8.0sp"
                    android:textColor="#ffaaaaaa"
                    android:ellipsize="end"
                    android:gravity="start|center"
                    android:id="@id/contact_id"
                    android:paddingTop="3.0dip"
                    android:paddingBottom="3.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2.0dip"
                    android:maxWidth="80.0dip"
                    android:maxLines="2"
                    android:paddingVertical="3.0dip" />
            </LinearLayout>
        </LinearLayout>
        <Space
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.0" />
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@id/header_settings_btn"
            android:padding="1.0dip"
            android:layout_width="15.0dip"
            android:layout_height="15.0dip"
            android:src="@drawable/ic_menu_messenger" />
    </LinearLayout>
    <View
        android:id="@id/header_divider"
        android:background="#ff2f2f2f"
        android:layout_width="0.0dip"
        android:layout_height="1.0dip"
        android:layout_marginLeft="4.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginRight="4.0dip"
        android:layout_below="@id/header_container"
        android:layout_marginHorizontal="4.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_container" />
    <include
        android:id="@id/empty_chat_layout"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toTopOf="@id/input_field_chat_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        layout="@layout/messenger_empty_chat_layout" />
    <include
        android:id="@id/loader_chat_layout"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        layout="@layout/messenger_loader_chat_layout" />
    <include
        android:id="@id/chat_layout"
        android:visibility="visible"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toTopOf="@id/input_field_chat_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        layout="@layout/messenger_chat_layout" />
    <include
        android:id="@id/input_field_chat_layout"
        android:visibility="visible"
        android:layout_width="0.0dip"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4.0dip"
        android:layout_marginRight="4.0dip"
        android:layout_marginHorizontal="4.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        layout="@layout/messenger_input_field_layout" />
    <include
        android:id="@id/menu_chat_layout"
        android:visibility="gone"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_divider"
        layout="@layout/messenger_menu_layout" />
</androidx.constraintlayout.widget.ConstraintLayout>