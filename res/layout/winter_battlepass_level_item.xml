<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@id/item_level_usually_container_full"
        android:background="@drawable/battlepass_2025_background_item_usuality_battle_pass"
        android:layout_width="@dimen/_64sdp"
        android:layout_height="@dimen/_81sdp"
        android:layout_marginLeft="@dimen/_4sdp"
        android:layout_marginRight="@dimen/_4sdp"
        android:layout_marginHorizontal="@dimen/_4sdp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/item_level_usually_container"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <TextView
                android:textSize="@dimen/_5sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/item_level_name_usually"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginRight="@dimen/_6sdp"
                android:text="Название предмеета"
                android:lines="2"
                android:fontFamily="@font/heading_now_64_regular"
                android:layout_marginHorizontal="@dimen/_6sdp" />
            <FrameLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/item_level_ic_usually"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_41sdp" />
                <ru.mrlargha.commonui.utils.ui.CustomCardView
                    android:layout_gravity="bottom|center"
                    android:id="@id/usually_count_container"
                    android:paddingLeft="@dimen/_3sdp"
                    android:paddingTop="@dimen/_1sdp"
                    android:paddingRight="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_1sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_3sdp"
                    android:paddingVertical="@dimen/_1sdp"
                    app:backgroundMainColor="@color/white"
                    app:corners="@dimen/_3sdp">
                    <TextView
                        android:textSize="@dimen/_4sdp"
                        android:textColor="@color/black"
                        android:id="@id/tv_usually_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 шт."
                        android:fontFamily="@font/heading_now_64_regular" />
                </ru.mrlargha.commonui.utils.ui.CustomCardView>
            </FrameLayout>
            <ImageView
                android:id="@id/item_level_btn_usually"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:src="@drawable/battlepass_2025_btn_get_item_pass_red" />
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/item_level_background_usual"
            android:layout_width="@dimen/_64sdp"
            android:layout_height="@dimen/_81sdp"
            android:src="@drawable/battlepass_2025_background_item_locked_usual" />
        <ru.mrlargha.commonui.utils.ui.CustomCardView
            android:layout_gravity="right"
            android:id="@id/quality_button"
            android:visibility="gone"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_margin="@dimen/_1sdp"
            app:backgroundMainColor="@color/black"
            app:corners="@dimen/_2sdp">
            <TextView
                android:textSize="@dimen/_6sdp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="i"
                android:fontFamily="@font/heading_now_64_regular" />
        </ru.mrlargha.commonui.utils.ui.CustomCardView>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/_23sdp">
        <View
            android:id="@id/view_before_level"
            android:background="@color/battlepass1"
            android:layout_width="@dimen/_31sdp"
            android:layout_height="@dimen/_3sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <View
            android:id="@id/view_after_level"
            android:background="@color/battlepass1"
            android:layout_width="@dimen/_31sdp"
            android:layout_height="@dimen/_3sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <RelativeLayout
            android:id="@id/center"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@id/level_container"
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:src="@drawable/shape_progress_level_step"
                android:tint="@color/battlepass1"
                android:layout_centerInParent="true" />
            <TextView
                android:textSize="@dimen/_8sdp"
                android:textColor="@color/white"
                android:id="@id/level_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:layout_centerInParent="true" />
        </RelativeLayout>
        <View
            android:id="@id/boost2"
            android:background="@drawable/battlepass_2025_winter_boost_button"
            android:visibility="gone"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <View
            android:id="@id/boost4"
            android:background="@drawable/battlepass_2025_winter_boost_button"
            android:visibility="gone"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/center"
            app:layout_constraintTop_toTopOf="parent" />
        <View
            android:id="@id/boost1"
            android:background="@drawable/battlepass_2025_winter_boost_button"
            android:visibility="gone"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <View
            android:id="@id/boost3"
            android:background="@drawable/battlepass_2025_winter_boost_button"
            android:visibility="visible"
            android:layout_width="@dimen/_16sdp"
            android:layout_height="@dimen/_16sdp"
            android:layout_marginRight="@dimen/_14sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="@id/center"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@id/item_level_premium_container_full"
        android:background="@drawable/battlepass_2025_background_item_premium"
        android:layout_width="@dimen/_64sdp"
        android:layout_height="@dimen/_81sdp"
        android:layout_marginLeft="@dimen/_4sdp"
        android:layout_marginRight="@dimen/_4sdp"
        android:layout_marginHorizontal="@dimen/_4sdp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@id/item_level_premium_container"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">
            <TextView
                android:textSize="@dimen/_5sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@id/item_level_name_premium"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginRight="@dimen/_6sdp"
                android:text="Название предмеета"
                android:lines="2"
                android:fontFamily="@font/heading_now_64_regular"
                android:layout_marginHorizontal="@dimen/_6sdp" />
            <FrameLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@id/item_level_ic_premium"
                    android:layout_width="fill_parent"
                    android:layout_height="@dimen/_41sdp" />
                <ru.mrlargha.commonui.utils.ui.CustomCardView
                    android:layout_gravity="bottom|center"
                    android:id="@id/premium_container_count"
                    android:paddingLeft="@dimen/_3sdp"
                    android:paddingTop="@dimen/_1sdp"
                    android:paddingRight="@dimen/_3sdp"
                    android:paddingBottom="@dimen/_1sdp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/_3sdp"
                    android:paddingVertical="@dimen/_1sdp"
                    app:backgroundMainColor="@color/white"
                    app:corners="@dimen/_3sdp">
                    <TextView
                        android:textSize="@dimen/_4sdp"
                        android:textColor="@color/black"
                        android:id="@id/tv_premium_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 шт."
                        android:fontFamily="@font/heading_now_64_regular" />
                </ru.mrlargha.commonui.utils.ui.CustomCardView>
            </FrameLayout>
            <ImageView
                android:id="@id/item_level_btn_premium"
                android:layout_width="fill_parent"
                android:layout_height="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:src="@drawable/battlepass_2025_ic_battlepass_lock_premium" />
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@id/item_level_background_premium"
            android:layout_width="@dimen/_64sdp"
            android:layout_height="@dimen/_81sdp"
            android:src="@drawable/battlepass_2025_background_battlepass_item_locked_premium" />
        <ru.mrlargha.commonui.utils.ui.CustomCardView
            android:layout_gravity="right"
            android:id="@id/quality_button1"
            android:visibility="gone"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_margin="@dimen/_1sdp"
            app:backgroundMainColor="@color/black"
            app:corners="@dimen/_2sdp">
            <TextView
                android:textSize="@dimen/_6sdp"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="i"
                android:fontFamily="@font/heading_now_64_regular" />
        </ru.mrlargha.commonui.utils.ui.CustomCardView>
    </FrameLayout>
</LinearLayout>