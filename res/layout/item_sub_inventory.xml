<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@id/parentItem"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4.0dip"
    android:layout_marginEnd="4.0dip"
    app:cardCornerRadius="10.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/ivDefaultItem"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:src="@drawable/bg_item" />
    <ImageView
        android:id="@id/iv_effect_background"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop" />
    <ImageView
        android:id="@id/iv_effect_background_top"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop" />
    <ImageView
        android:layout_gravity="center"
        android:id="@id/ivItemImage"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <androidx.cardview.widget.CardView
        android:layout_gravity="center|left|top"
        android:id="@id/cvColoredItem"
        android:visibility="gone"
        android:layout_width="8.0dip"
        android:layout_height="8.0dip"
        android:layout_marginTop="8.0dip"
        android:layout_marginStart="8.0dip"
        app:cardCornerRadius="2.0dip" />
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center|right|top"
        android:id="@id/ivActiveItem"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:src="@drawable/ic_active_item"
        android:layout_marginEnd="8.0dip" />
    <ImageView
        android:layout_gravity="center"
        android:id="@id/ivItemDefaultImage"
        android:layout_width="24.0dip"
        android:layout_height="24.0dip"
        android:layout_marginBottom="8.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:textSize="10.0dip"
        android:textColor="@color/gray"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/tvTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.0dip"
        android:fontFamily="@font/pfdregular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivItemDefaultImage" />
    <TextView
        android:textSize="@dimen/_9sdp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="end|center"
        android:layout_gravity="end|bottom|center"
        android:id="@id/tvDescriptionText"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_6sdp"
        android:maxLines="2"
        android:shadowColor="@color/black"
        android:shadowDx="-4.0"
        android:shadowDy="-2.0"
        android:shadowRadius="1.0"
        android:fontFamily="@font/pfdregular"
        android:layout_marginEnd="@dimen/_6sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <TextView
        android:textSize="10.0dip"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:layout_gravity="end|bottom|center"
        android:id="@id/tvItemNum"
        android:background="@drawable/bg_white"
        android:visibility="gone"
        android:layout_width="14.0dip"
        android:layout_height="14.0dip"
        android:layout_marginBottom="1.0dip"
        android:layout_marginEnd="1.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageView
        android:id="@id/iv_effect_foreground"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:scaleType="centerCrop" />
    <View
        android:layout_gravity="center"
        android:id="@id/viewCenter"
        android:background="@color/black_type1"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <View
        android:id="@id/viewColored"
        android:background="@drawable/bg_white_borders"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
</androidx.cardview.widget.CardView>