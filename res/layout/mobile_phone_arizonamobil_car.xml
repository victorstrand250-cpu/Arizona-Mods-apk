<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mp_arizonamobile_car_item"
    android:background="@drawable/border_radius"
    android:layout_width="144.0dip"
    android:layout_height="40.0dip"
    android:layout_marginBottom="8.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/mp_arizonamobile_car_image"
        android:layout_width="40.0dip"
        android:layout_height="20.0dip"
        android:layout_marginLeft="2.0dip"
        android:src="@drawable/mp_arizonamobil_car_item"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/mp_arizonamobile_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/mp_arizonamobile_car_image"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="12.0dip"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:id="@id/mp_arizonamobile_car_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VW Polo"
            android:fontFamily="@font/gotham"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/mp_arizonamobile_gps"
            android:layout_width="10.0dip"
            android:layout_height="10.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/ic_gps_pointer"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mp_arizonamobile_car_name" />
        <TextView
            android:textSize="8.0dip"
            android:textStyle="normal"
            android:textColor="@color/white"
            android:id="@id/mp_arizonamobile_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2.0dip"
            android:text="1.500 м"
            android:fontFamily="@font/gotham"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@id/mp_arizonamobile_gps"
            app:layout_constraintTop_toBottomOf="@id/mp_arizonamobile_car_name" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/mp_arizonamobile_car_arrow"
        android:layout_width="12.0dip"
        android:layout_height="wrap_content"
        android:layout_marginLeft="2.0dip"
        android:layout_marginRight="6.0dip"
        android:src="@drawable/ic_arrow"
        android:rotation="180.0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>