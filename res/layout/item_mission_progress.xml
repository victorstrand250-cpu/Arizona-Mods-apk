<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:background="@color/ap_transparent"
    android:layout_width="fill_parent"
    android:layout_height="15.0dip"
    android:layout_marginTop="5.0dip"
    android:layout_marginBottom="5.0dip"
    android:layout_marginVertical="5.0dip"
    app:cardBackgroundColor="@color/ap_transparent"
    app:cardCornerRadius="16.0dip"
    app:cardElevation="0.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:background="@color/ap_transparent"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@id/progressBar"
            android:background="@color/ap_transparent"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            app:indicatorColor="@color/green_50_transparent"
            app:trackColor="@color/black_35_transparent"
            app:trackCornerRadius="0.0dip"
            app:trackThickness="15.0dip" />
        <TextView
            android:textSize="@dimen/_6sdp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/mission_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Собрать хлопок"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/gotham_medium"
            android:layout_marginStart="5.0dip"
            android:layout_alignParentStart="true" />
        <TextView
            android:textSize="6.0sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/progress_text"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/gotham_medium"
            android:layout_marginEnd="5.0dip"
            android:layout_alignParentEnd="true" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/ic_done"
            android:visibility="gone"
            android:layout_width="10.0dip"
            android:layout_height="10.0dip"
            android:src="@drawable/ic_checked_green"
            android:tint="@color/white"
            android:layout_alignParentTop="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="6.0dip"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>
</androidx.cardview.widget.CardView>