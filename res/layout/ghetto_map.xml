<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/neighbor_game_task_screen"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.davemorrissey.labs.subscaleview.SubsamplingScaleImageView
        android:id="@id/mapView"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <ru.mrlargha.arizonaui.ghetto.GridOverlayView
        android:id="@id/overlayView"
        android:background="@android:color/transparent"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="fill_parent"
        android:layout_marginLeft="@dimen/_24sdp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="@dimen/_100sdp"
            android:layout_height="@dimen/_80sdp"
            android:src="@drawable/ghetto_logo" />
        <View
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
        <androidx.cardview.widget.CardView
            android:id="@id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_24sdp"
            app:cardBackgroundColor="#1affffff"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0.0dip">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_marginVertical="@dimen/_8sdp">
                <ImageView
                    android:layout_width="@dimen/_12sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_marginRight="@dimen/_8sdp"
                    android:src="@drawable/ghetto_info_ic_1" />
                <TextView
                    android:textSize="@dimen/_10sdp"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Подробнее"
                    android:fontFamily="@font/pfdindisplaypro_regular" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="fill_parent"
        android:layout_marginLeft="@dimen/_24sdp"
        android:layout_marginTop="@dimen/_60sdp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_weight="1.0" />
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginBottom="@dimen/_8sdp"
            android:layout_marginVertical="@dimen/_8sdp">
            <ImageView
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_marginRight="@dimen/_8sdp"
                android:src="@drawable/ghetto_info_ic_2" />
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Подсказка"
                android:fontFamily="@font/pfdindisplaypro_regular" />
        </LinearLayout>
        <TextView
            android:textSize="@dimen/_8sdp"
            android:textColor="#ffababab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_24sdp"
            android:text="Кликните на территорию, чтобы открыть меню и начать сражение."
            android:fontFamily="@font/pfdindisplaypro_regular" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>