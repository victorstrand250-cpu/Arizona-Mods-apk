<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/rodina_proposal_screen"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/rodina_proposal_container"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.2722"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.625">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/rodina_proposal_bg"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:src="@drawable/hud_proposal_bg"
            android:scaleX="2.0"
            android:scaleY="1.2" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/proposal_accept_btn"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:src="@drawable/hud_like_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.34013"
            app:layout_constraintStart_toStartOf="@id/proposal_left_v_line"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.0833" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/proposal_info_container"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.4931"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.4166">
            <TextView
                android:textSize="@dimen/_6sdp"
                android:textStyle="bold"
                android:textColor="#ffbabdbf"
                android:id="@id/proposal_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПРЕДЛОЖЕНИЕ ОБМЕНА ОТ"
                android:fontFamily="@font/gotham"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@id/proposal_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7.0dip"
                android:text="Maks_Mironow"
                android:fontFamily="@font/gothampro_bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/proposal_title" />
            <TextView
                android:textSize="@dimen/_5sdp"
                android:textStyle="bold"
                android:textColor="#ffbabdbf"
                android:id="@id/proposal_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4.0dip"
                android:text="ID:666"
                android:fontFamily="@font/gotham"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/proposal_nickname" />
            <ProgressBar
                android:id="@id/proposal_progress"
                android:background="@drawable/progress_background"
                android:layout_width="fill_parent"
                android:layout_height="4.0dip"
                android:layout_marginTop="9.0dip"
                android:progress="50"
                android:progressDrawable="@drawable/white_progress_line"
                android:progressTint="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/proposal_decline_btn"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:src="@drawable/hud_dislike_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/proposal_right_v_line"
            app:layout_constraintHeight_percent="0.34013"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.0833" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/proposal_left_v_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.19066148" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/proposal_right_v_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.81322956" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>