<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    android:id="@id/card"
    android:layout_width="@dimen/_64sdp"
    android:layout_height="@dimen/_64sdp"
    android:layout_margin="4.0dip"
    app:cardBackgroundColor="#4dffffff"
    app:cardCornerRadius="10.0dip"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/layout"
        android:background="#00ffffff"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/backgorund_image"
            android:background="#00ffffff"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginLeft="8.0dip"
            android:layout_marginTop="8.0dip"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:cropToPadding="true"
            android:layout_marginStart="8.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="1.0"
            app:srcCompat="@drawable/bag_bg" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4.0dip"
            android:layout_marginTop="8.0dip"
            android:layout_marginStart="4.0dip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/backgorund_image"
            app:srcCompat="@drawable/bag_icon" />
        <TextView
            android:textSize="@dimen/_8sdp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@id/element_name"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginRight="4.0dip"
            android:layout_marginBottom="8.0dip"
            android:text="Имущество"
            android:fontFamily="@font/gotham"
            android:layout_marginEnd="4.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/icon"
            app:layout_constraintTop_toBottomOf="@id/icon"
            app:layout_constraintVertical_bias="1.0" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>