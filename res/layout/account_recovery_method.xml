<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/account_recovery_method"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/auth_background"
        android:background="@drawable/authorization_bg"
        android:layout_width="350.0dip"
        android:layout_height="fill_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="16.0dip"
            android:textColor="@color/white"
            android:id="@id/account_recovery_method_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35.0dip"
            android:text="@string/password_reset"
            android:fontFamily="@font/pfdregular"
            android:textFontWeight="500"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/account_recovery_method_container"
            android:layout_width="300.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="15.0dip"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/account_recovery_method_title">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/account_recovery_method_mail"
                android:background="@drawable/authorization_border"
                android:layout_width="fill_parent"
                android:layout_height="50.0dip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/account_recovery_method_mail_icon"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_marginLeft="10.0dip"
                    android:src="@drawable/mail_ic"
                    android:tint="#ff7e7e7e"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:textSize="18.0dip"
                    android:textColor="#ff7e7e7e"
                    android:id="@id/account_recovery_mail_placeholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6.0dip"
                    android:text="@string/email"
                    android:fontFamily="@font/heading_now_64_regular"
                    android:textFontWeight="400"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/account_recovery_method_mail_icon"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/account_recovery_method_vk"
                android:background="@drawable/authorization_border"
                android:layout_width="fill_parent"
                android:layout_height="50.0dip"
                android:layout_marginTop="15.0dip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/account_recovery_method_mail">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/account_recovery_method_vk_icon"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_marginLeft="10.0dip"
                    android:src="@drawable/vk_ic"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:textSize="18.0dip"
                    android:textColor="#ff979797"
                    android:id="@id/account_recovery_vk_placeholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6.0dip"
                    android:text="@string/vkontakte"
                    android:fontFamily="@font/heading_now_64_regular"
                    android:textFontWeight="400"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/account_recovery_method_vk_icon"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/account_recovery_method_telegram"
                android:background="@drawable/authorization_border"
                android:layout_width="fill_parent"
                android:layout_height="50.0dip"
                android:layout_marginTop="15.0dip"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@id/account_recovery_method_vk">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@id/account_recovery_method_telegram_icon"
                    android:layout_width="20.0dip"
                    android:layout_height="20.0dip"
                    android:layout_marginLeft="10.0dip"
                    android:src="@drawable/ic_telegram"
                    android:tint="#ff7e7e7e"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <TextView
                    android:textSize="18.0dip"
                    android:textColor="#ff979797"
                    android:id="@id/account_recovery_telegram_placeholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6.0dip"
                    android:text="@string/telegram"
                    android:fontFamily="@font/heading_now_64_regular"
                    android:textFontWeight="400"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@id/account_recovery_method_telegram_icon"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/account_recovery_method_next"
            android:background="@drawable/authorization_border_red"
            android:layout_width="300.0dip"
            android:layout_height="40.0dip"
            android:layout_marginTop="25.0dip"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/account_recovery_method_container">
            <TextView
                android:textSize="16.0dip"
                android:textColor="@color/white"
                android:id="@id/account_recovery_method_btn_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6.0dip"
                android:text="@string/next"
                android:fontFamily="@font/heading_now_64_regular"
                android:textFontWeight="400"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>