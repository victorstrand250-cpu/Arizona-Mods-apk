<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/image"
            android:layout_width="30.0dip"
            android:layout_height="30.0dip"
            android:src="@drawable/ic_sad_screen_messenger" />
        <TextView
            android:textSize="10.0sp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="20.0dip"
            android:text="Ваш список контактов пуст"
            android:fontFamily="@font/pfdindisplaypro_regular"
            android:layout_marginHorizontal="20.0dip" />
    </LinearLayout>
    <Button
        android:textSize="10.0sp"
        android:textColor="@color/white"
        android:id="@id/button_new_chat"
        android:background="@drawable/blue_button_background"
        android:layout_width="fill_parent"
        android:layout_height="30.0dip"
        android:layout_marginLeft="10.0dip"
        android:layout_marginRight="10.0dip"
        android:layout_marginBottom="10.0dip"
        android:text="Начать общение"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"
        android:fontFamily="@font/pfdindisplaypro_medium"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginHorizontal="10.0dip" />
</RelativeLayout>