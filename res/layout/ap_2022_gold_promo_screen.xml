<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/promo_gold_layout"
    android:clickable="true"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/imageView2"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/gold_promo_bg" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/purchase_button"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0.0dip"
        android:layout_height="30.0dip"
        android:layout_marginTop="8.0dip"
        android:elevation="1.0dip"
        app:layout_constraintDimensionRatio="48:9"
        app:layout_constraintStart_toStartOf="@id/center_guide"
        app:layout_constraintTop_toBottomOf="@id/pass_price"
        app:srcCompat="@drawable/ap_purchase_gold_button" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/imageView3"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:scaleType="fitCenter"
        android:layout_marginEnd="16.0dip"
        app:layout_constraintBottom_toTopOf="@id/line_2"
        app:layout_constraintDimensionRatio=""
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/center_guide"
        app:layout_constraintTop_toTopOf="@id/line_1"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/ap_gold_promo_text" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@id/center_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@id/line_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.1" />
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@id/line_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.7" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/close_button"
        android:layout_width="40.0dip"
        android:layout_height="40.0dip"
        android:layout_marginTop="16.0dip"
        app:layout_constraintEnd_toEndOf="@id/imageView3"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/cross" />
    <TextView
        android:textSize="@dimen/_22sdp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@id/pass_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:text="2 000"
        android:fontFamily="@font/pfdregular"
        android:layout_marginStart="20.0dip"
        app:layout_constraintStart_toStartOf="@id/center_guide"
        app:layout_constraintTop_toTopOf="@id/line_2" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/imageView10"
        android:layout_width="34.0dip"
        android:layout_height="13.0dip"
        app:layout_constraintStart_toEndOf="@id/pass_price"
        app:layout_constraintTop_toTopOf="@id/pass_price"
        app:srcCompat="@drawable/azcoin" />
</androidx.constraintlayout.widget.ConstraintLayout>