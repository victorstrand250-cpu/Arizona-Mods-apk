<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:id="@id/parentLayout"
    android:background="@color/transparent80_grey"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/craft_container"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/btnBack"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:src="@drawable/ic_arrow_back_8"
            app:layout_constraintEnd_toEndOf="@id/guidelineVer3"
            app:layout_constraintHeight_percent="0.0944"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.0623" />
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold|italic"
            android:textColor="@color/white"
            android:gravity="start|center"
            android:id="@id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="верстак"
            android:textAllCaps="true"
            android:layout_marginStart="16.0dip"
            android:autoSizeTextType="uniform"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintTop_toTopOf="@id/btnBack" />
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@id/rvMenu"
            android:background="@android:color/transparent"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:paddingEnd="60.0dip"
            android:layout_marginStart="60.0dip"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/viewLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvTitle"
            app:layout_constraintTop_toTopOf="parent" />
        <ImageView
            android:id="@id/viewLine"
            android:layout_width="fill_parent"
            android:layout_height="2.0dip"
            android:src="@drawable/straight_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@id/rvColors"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginTop="16.0dip"
            android:layout_marginStart="32.0dip"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/guidelineHor1"
            app:layout_constraintEnd_toStartOf="@id/guidelineEnd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guidelineHor2"
            app:spanCount="3" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.35" />
        <View
            android:id="@id/bgRVCraft"
            android:background="@drawable/left_navigation"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewLine" />
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@id/rvCraft"
            android:background="@android:color/transparent"
            android:paddingBottom="12.0dip"
            android:layout_width="0.0dip"
            android:layout_height="0.0dip"
            android:layout_marginTop="20.0dip"
            android:layout_marginStart="16.0dip"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/guidelineHor1"
            app:layout_constraintEnd_toStartOf="@id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guidelineHor2" />
        <ImageView
            android:id="@id/ivBgFlashLight"
            android:background="@drawable/bg_failure_red"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <ImageView
            android:id="@id/ivItemIcon"
            android:layout_width="82.0dip"
            android:layout_height="82.0dip"
            android:layout_marginTop="20.0dip"
            android:src="@drawable/ic_shotgun_bullet_82"
            android:layout_marginStart="28.0dip"
            app:layout_constraintStart_toStartOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/guidelineHor2" />
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textStyle="italic"
            android:textColor="@color/white"
            android:gravity="start|center"
            android:id="@id/tvItemName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12.0dip"
            android:textAllCaps="true"
            android:fontFamily="@font/pfdbold"
            android:layout_marginStart="20.0dip"
            android:autoSizeTextType="uniform"
            app:layout_constraintStart_toEndOf="@id/ivItemIcon"
            app:layout_constraintTop_toTopOf="@id/ivItemIcon" />
        <TextView
            android:textSize="@dimen/_8sdp"
            android:textColor="@color/grey_type2"
            android:id="@id/tvItemDescription"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:maxWidth="@dimen/_160sdp"
            android:textAllCaps="true"
            android:fontFamily="@font/pfdregular"
            app:layout_constraintEnd_toStartOf="@id/tvColorTitle"
            app:layout_constraintStart_toStartOf="@id/tvItemName"
            app:layout_constraintTop_toBottomOf="@id/tvItemName" />
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textStyle="italic"
            android:textColor="@color/white"
            android:id="@id/tvResourcesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:text="Необходимые ресурсы"
            android:textAllCaps="true"
            android:fontFamily="@font/pfdbold"
            android:layout_marginStart="@dimen/_20sdp"
            app:layout_constraintStart_toEndOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/ivItemIcon" />
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@id/rvNeedResources"
            android:background="@android:color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_20sdp"
            android:layout_marginStart="@dimen/_20sdp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintStart_toEndOf="@id/guideline"
            app:layout_constraintTop_toBottomOf="@id/tvResourcesTitle" />
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textStyle="italic"
            android:textColor="@color/white"
            android:id="@id/tvColorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="цвет  "
            android:textAllCaps="true"
            android:fontFamily="@font/pfdbold"
            app:layout_constraintBottom_toBottomOf="@id/tvResourcesTitle"
            app:layout_constraintStart_toStartOf="@id/cvColor"
            app:layout_constraintTop_toTopOf="@id/tvResourcesTitle" />
        <com.google.android.material.card.MaterialCardView
            android:id="@id/cvColor"
            android:background="@color/transparent100"
            android:visibility="gone"
            android:layout_width="72.0dip"
            android:layout_height="72.0dip"
            android:layout_marginTop="4.0dip"
            app:cardCornerRadius="10.0dip"
            app:layout_constraintBottom_toBottomOf="@id/rvNeedResources"
            app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
            app:layout_constraintTop_toTopOf="@id/rvNeedResources">
            <View
                android:layout_gravity="center"
                android:id="@id/viewTopRight"
                android:background="@drawable/bg_item"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.cardview.widget.CardView
                android:layout_gravity="center"
                android:id="@id/cvColorIcon"
                android:layout_width="18.0dip"
                android:layout_height="15.0dip"
                app:cardCornerRadius="5.0dip" />
            <TextView
                android:textSize="@dimen/_9sdp"
                android:textColor="@color/white"
                android:gravity="bottom|center"
                android:layout_gravity="bottom|center"
                android:id="@id/tvColorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4.0dip"
                android:text="Без цвета"
                android:maxLines="2"
                android:fontFamily="@font/pfdregular"
                android:autoSizeTextType="uniform" />
        </com.google.android.material.card.MaterialCardView>
        <ImageButton
            android:id="@id/ivMinus"
            android:background="@drawable/border_radius_white_5"
            android:layout_width="30.0dip"
            android:layout_height="@dimen/_22sdp"
            android:src="@drawable/baseline_minus_24"
            android:layout_marginStart="20.0dip"
            app:layout_constraintBottom_toTopOf="@id/guidelineHor3"
            app:layout_constraintStart_toEndOf="@id/guideline" />
        <EditText
            android:textSize="@dimen/_8sdp"
            android:textStyle="italic"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@id/etResourcesCount"
            android:background="@drawable/bg_craft_amount"
            android:layout_width="72.0dip"
            android:layout_height="0.0dip"
            android:text="11"
            android:maxLength="4"
            android:inputType="number"
            android:fontFamily="@font/pfdbold"
            android:layout_marginStart="26.0dip"
            app:layout_constraintBottom_toBottomOf="@id/ivMinus"
            app:layout_constraintStart_toStartOf="@id/ivMinus"
            app:layout_constraintTop_toTopOf="@id/ivMinus" />
        <ImageButton
            android:id="@id/ivPlus"
            android:background="@drawable/border_radius_white_5"
            android:layout_width="30.0dip"
            android:layout_height="0.0dip"
            android:src="@drawable/baseline_plus_24"
            android:layout_marginStart="68.0dip"
            app:layout_constraintBottom_toBottomOf="@id/ivMinus"
            app:layout_constraintStart_toStartOf="@id/etResourcesCount"
            app:layout_constraintTop_toTopOf="@id/ivMinus" />
        <LinearLayout
            android:id="@id/fieldLinear"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginStart="4.0dip"
            app:layout_constraintBottom_toBottomOf="@id/ivMinus"
            app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
            app:layout_constraintStart_toEndOf="@id/ivPlus"
            app:layout_constraintTop_toTopOf="@id/ivMinus">
            <include
                android:id="@id/experienceField"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                layout="@layout/item_info_cost" />
            <include
                android:id="@id/successChanceField"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:layout_marginStart="4.0dip"
                layout="@layout/item_info_cost" />
            <include
                android:id="@id/costField"
                android:visibility="gone"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:layout_marginStart="4.0dip"
                layout="@layout/item_info_cost" />
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@id/cost_container"
                android:background="@drawable/craft_item_bg_selected"
                android:paddingLeft="@dimen/_10sdp"
                android:paddingRight="@dimen/_10sdp"
                android:layout_width="0.0dip"
                android:layout_height="fill_parent"
                android:layout_weight="1.0"
                android:layout_marginStart="@dimen/_4sdp"
                android:paddingHorizontal="@dimen/_10sdp">
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_7sdp"
                        android:textStyle="italic"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="общ. стоимость"
                        android:textAllCaps="true"
                        android:fontFamily="@font/pfdbold" />
                    <TextView
                        android:textSize="@dimen/_7sdp"
                        android:textStyle="italic"
                        android:textColor="@color/white"
                        android:gravity="end"
                        android:id="@id/tv_total_cost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:textAllCaps="true"
                        android:fontFamily="@font/pfdbold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/_5sdp"
                        android:textStyle="italic"
                        android:textColor="@color/white"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="стоимость 1 попытки"
                        android:alpha="0.5"
                        android:textAllCaps="true"
                        android:fontFamily="@font/pfdbold" />
                    <TextView
                        android:textSize="@dimen/_5sdp"
                        android:textStyle="italic"
                        android:textColor="@color/white"
                        android:gravity="end"
                        android:id="@id/tv_cost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.0"
                        android:alpha="0.5"
                        android:textAllCaps="true"
                        android:fontFamily="@font/pfdbold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textStyle="bold|italic"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@id/btnEnableCreateItem"
            android:background="@drawable/bg_create_item_craft"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginTop="16.0dip"
            android:text="Создать предмет"
            android:textAllCaps="true"
            android:fontFamily="@font/pfdregular"
            app:layout_constraintBottom_toTopOf="@id/guidelineHor1"
            app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@id/ivMinus" />
        <Button
            android:enabled="true"
            android:id="@id/btnDisableCreateItem"
            android:background="@drawable/btn_create_item_disabled"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginTop="16.0dip"
            app:layout_constraintBottom_toTopOf="@id/guidelineHor1"
            app:layout_constraintEnd_toEndOf="@id/guidelineEnd"
            app:layout_constraintStart_toStartOf="@id/ivMinus" />
        <ProgressBar
            android:id="@id/progressBar"
            android:background="@drawable/craft_item_bg_selected"
            android:visibility="gone"
            android:layout_width="0.0dip"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginTop="12.0dip"
            android:max="100"
            android:indeterminate="false"
            android:progressDrawable="@drawable/craft_progress_bar"
            android:layout_marginEnd="4.0dip"
            app:layout_constraintBottom_toTopOf="@id/guidelineHor1"
            app:layout_constraintEnd_toStartOf="@id/btnCancelCraft"
            app:layout_constraintStart_toStartOf="@id/ivMinus"
            app:layout_constraintTop_toBottomOf="@id/fieldLinear"
            style="?android:progressBarStyleHorizontal" />
        <Button
            android:textSize="@dimen/_10sdp"
            android:textStyle="italic"
            android:textColor="@color/black"
            android:id="@id/btnCancelCraft"
            android:background="@drawable/border_radius_5"
            android:visibility="gone"
            android:layout_width="180.0dip"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginTop="12.0dip"
            android:text="отменить"
            android:textAllCaps="true"
            android:fontFamily="@font/pfdbold"
            android:backgroundTint="@color/white"
            app:layout_constraintBottom_toTopOf="@id/guidelineHor1"
            app:layout_constraintEnd_toEndOf="@id/fieldLinear"
            app:layout_constraintTop_toBottomOf="@id/fieldLinear" />
        <androidx.constraintlayout.widget.Group
            android:id="@id/groupCharacter"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="rvMenu,rvCraft,bgRVCraft,ivItemIcon,tvItemName,tvItemDescription,tvResourcesTitle,rvNeedResources,ivMinus,etResourcesCount,fieldLinear, ivPlus,tvColorTitle,cvColor " />
        <include
            android:id="@id/successLayout"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            layout="@layout/layout_craft_success" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.98" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineHor1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.95" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineHor2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.1" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@id/guidelineHor3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.85" />
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@id/guidelineVer3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.06" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@id/container_progress"
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:indeterminate="true"
        android:indeterminateTint="#fffdfdfd" />
</FrameLayout>