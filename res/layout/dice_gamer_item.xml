<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/dice_gamer_item"
    android:layout_width="fill_parent"
    android:layout_height="25.0dip"
    android:layout_marginTop="2.0dip"
    android:layout_marginBottom="2.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@id/gamer_icon"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:src="@drawable/dice_host_ic"
        app:layout_constraintHeight_percent="1.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.1" />
    <TextView
        android:textSize="@dimen/_9sdp"
        android:textStyle="normal"
        android:textColor="#ffffffff"
        android:id="@id/gamer_nickname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6.0dip"
        android:text="Max Mironov: "
        android:fontFamily="@font/gotham"
        app:layout_constraintBottom_toBottomOf="@id/gamer_icon"
        app:layout_constraintLeft_toRightOf="@id/gamer_icon"
        app:layout_constraintTop_toTopOf="@id/gamer_icon" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/dice_score_bg"
        android:background="@drawable/dice_score_bg"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginTop="2.0dip"
        android:layout_marginBottom="2.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="1.0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.33">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/dice_score_container"
            android:layout_width="0.0dip"
            android:layout_height="fill_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.85">
            <TextView
                android:textSize="@dimen/_9sdp"
                android:textStyle="normal"
                android:textColor="#50ffffff"
                android:id="@id/dice_score_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="2.0dip"
                android:text="Выпало:"
                android:fontFamily="@font/gotham"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintRight_toLeftOf="@id/dice_score"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:textSize="@dimen/_9sdp"
                android:textStyle="normal"
                android:textColor="#ffffffff"
                android:id="@id/dice_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:fontFamily="@font/gothampro_bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintLeft_toRightOf="@id/dice_score_title"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>