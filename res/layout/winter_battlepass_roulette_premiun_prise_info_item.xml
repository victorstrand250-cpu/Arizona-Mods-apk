<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="64.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="8.0dip"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:id="@id/tv_prise_name"
        android:layout_width="wrap_content"
        android:layout_height="30.0dip"
        android:text="Lamborghini Huracan Sterrato"
        android:maxLines="3"
        android:textAlignment="center" />
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@id/btn_sell_prise"
        android:background="@drawable/winter_battlepass_roulette_bg_white"
        android:paddingTop="1.0dip"
        android:paddingBottom="1.0dip"
        android:layout_width="fill_parent"
        android:layout_height="24.0dip"
        android:paddingVertical="1.0dip">
        <TextView
            android:textSize="8.0dip"
            android:textColor="@color/battlepass_text"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Продать за" />
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="8.0dip"
                android:textStyle="bold"
                android:textColor="@color/battlepass_text"
                android:id="@id/price_prise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30" />
            <ImageView
                android:layout_width="8.0dip"
                android:layout_height="8.0dip"
                android:src="@drawable/battlepass_2025_ic_battlepoints"
                android:layout_marginStart="1.0dip" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@id/selled_prise"
        android:background="@drawable/winter_battlepass_roulette_bg_white_transparent"
        android:paddingTop="1.0dip"
        android:paddingBottom="1.0dip"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="24.0dip"
        android:paddingVertical="1.0dip">
        <TextView
            android:textSize="8.0dip"
            android:textColor="#ffffffff"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Продано" />
    </LinearLayout>
</LinearLayout>