<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/mp_driver_orders_page"
    android:layout_width="160.0dip"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <FrameLayout
        android:id="@id/mp_driver_header"
        android:layout_width="160.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="16.0dip"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/mp_driver_header_back"
            android:layout_width="16.0dip"
            android:layout_height="16.0dip"
            android:layout_marginLeft="8.0dip"
            android:src="@drawable/ic_arrow" />
        <TextView
            android:textSize="10.0dip"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:id="@id/mp_driver_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DRIVER"
            android:fontFamily="@font/gotham"
            android:letterSpacing="0.5" />
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/driver_info_container"
        android:layout_width="140.0dip"
        android:layout_height="wrap_content"
        android:layout_marginTop="32.0dip"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mp_driver_header">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/driver_image"
            android:layout_width="36.0dip"
            android:layout_height="36.0dip"
            android:src="@drawable/uber_driver"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:textSize="10.0dip"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@id/driver_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5.0dip"
            android:layout_marginTop="8.0dip"
            android:text="John Brown"
            android:fontFamily="@font/gotham"
            app:layout_constraintBottom_toTopOf="@id/driver_star"
            app:layout_constraintLeft_toRightOf="@id/driver_image"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@id/driver_star"
            android:layout_width="10.0dip"
            android:layout_height="10.0dip"
            android:layout_marginLeft="6.0dip"
            android:layout_marginTop="2.0dip"
            android:src="@drawable/ic_star_active"
            app:layout_constraintLeft_toRightOf="@id/driver_image"
            app:layout_constraintTop_toBottomOf="@id/driver_name" />
        <TextView
            android:textSize="10.0dip"
            android:textStyle="bold"
            android:textColor="#fffdb936"
            android:id="@id/driver_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2.0dip"
            android:layout_marginTop="1.0dip"
            android:text="5.0"
            android:fontFamily="@font/gotham"
            app:layout_constraintBottom_toBottomOf="@id/driver_star"
            app:layout_constraintLeft_toRightOf="@id/driver_star"
            app:layout_constraintTop_toTopOf="@id/driver_star" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/driver_car_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16.0dip"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/driver_image">
            <TextView
                android:textSize="8.0dip"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:ellipsize="marquee"
                android:id="@id/driver_car_name"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="48.0dip"
                android:text="Mercedes-Benz GLS 2020"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:fontFamily="@font/gotham"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:textSize="7.0dip"
                android:textStyle="bold"
                android:textColor="#ff7b7b7b"
                android:id="@id/driver_car"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:text="Автомобиль"
                android:fontFamily="@font/gotham"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/driver_car_name" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/driver_order_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12.0dip"
            android:layout_marginTop="16.0dip"
            app:layout_constraintLeft_toRightOf="@id/driver_car_info"
            app:layout_constraintTop_toBottomOf="@id/driver_image">
            <TextView
                android:textSize="8.0dip"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@id/driver_order_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10"
                android:fontFamily="@font/gotham"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:textSize="7.0dip"
                android:textStyle="bold"
                android:textColor="#ff7b7b7b"
                android:id="@id/driver_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:text="Заказов"
                android:fontFamily="@font/gotham"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/driver_order_count" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@id/driver_priority_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12.0dip"
            android:layout_marginTop="16.0dip"
            app:layout_constraintLeft_toRightOf="@id/driver_order_info"
            app:layout_constraintTop_toBottomOf="@id/driver_image">
            <TextView
                android:textSize="8.0dip"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:id="@id/driver_priority_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Комфорт"
                android:fontFamily="@font/gotham"
                android:autoSizeMinTextSize="5.0sp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <TextView
                android:textSize="7.0dip"
                android:textStyle="bold"
                android:textColor="#ff7b7b7b"
                android:id="@id/driver_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2.0dip"
                android:text="Класс"
                android:fontFamily="@font/gotham"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/driver_priority_name" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="8.0dip"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:id="@id/driver_available_orders"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8.0dip"
        android:text="Доступные заказы"
        android:fontFamily="@font/gotham"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/driver_info_container" />
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@id/driver_orders"
        android:fadingEdgeLength="10.0dip"
        android:layout_width="0.0dip"
        android:layout_height="84.0dip"
        android:layout_marginTop="6.0dip"
        android:requiresFadingEdge="vertical"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/driver_available_orders"
        app:spanCount="1" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/driver_action_container"
        android:background="@drawable/driver_yellow"
        android:layout_width="128.0dip"
        android:layout_height="32.0dip"
        android:layout_marginTop="6.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/driver_orders">
        <TextView
            android:textSize="8.0dip"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@id/driver_job_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Начать работу"
            android:fontFamily="@font/gotham"
            android:autoSizeMinTextSize="5.0sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>