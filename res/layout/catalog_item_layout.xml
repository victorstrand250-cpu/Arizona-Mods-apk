<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:background="@drawable/bg_catalog_item"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20.0dip"
    android:layout_marginEnd="20.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView
        android:textSize="14.0sp"
        android:textColor="@color/white"
        android:gravity="start"
        android:id="@id/catalog_name_text"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginRight="20.0dip"
        android:text="item name"
        android:fontFamily="@font/gotham"
        android:layout_marginHorizontal="20.0dip" />
    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="100.0dip">
        <ProgressBar
            android:id="@id/catalog_progress_bar"
            android:visibility="visible"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_margin="5.0dip"
            android:indeterminateTint="@color/white" />
        <ImageView
            android:id="@id/catalog_image"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <TextView
            android:textSize="16.0sp"
            android:textColor="@color/white"
            android:gravity="start"
            android:id="@id/catalog_item_price_text"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20.0dip"
            android:layout_marginRight="20.0dip"
            android:layout_marginBottom="10.0dip"
            android:text="item price"
            android:layout_alignParentBottom="true"
            android:fontFamily="@font/gothampro_bold"
            android:layout_marginHorizontal="20.0dip" />
    </RelativeLayout>
</LinearLayout>