<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:paddingBottom="4.0dip"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="@dimen/_8sdp"
        android:textStyle="bold|italic"
        android:textColor="@color/white"
        android:id="@id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        app:layout_constraintBottom_toBottomOf="@id/tvProgressCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvProgressCount" />
    <TextView
        android:textSize="@dimen/_10sdp"
        android:textStyle="bold|italic"
        android:textColor="@color/white"
        android:id="@id/tvProgressCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        app:layout_constraintEnd_toStartOf="@id/tvProgressCountPlus"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:textSize="@dimen/_10sdp"
        android:textStyle="bold|italic"
        android:textColor="@color/white"
        android:id="@id/tvProgressCountPlus"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAllCaps="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ru.mrlargha.commonui.utils.progressBar.StoriesProgressView
        android:layout_gravity="top"
        android:id="@id/progressView"
        android:layout_width="fill_parent"
        android:layout_height="3.0dip"
        android:layout_marginTop="4.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:progressCount="10" />
</androidx.constraintlayout.widget.ConstraintLayout>