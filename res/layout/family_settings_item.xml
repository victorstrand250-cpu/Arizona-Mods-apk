<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="horizontal"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_4sdp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@id/card"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/_72sdp"
        app:cardBackgroundColor="#1ae1aa33"
        app:cardCornerRadius="@dimen/_8sdp"
        app:cardElevation="0.0dip">
        <View
            android:id="@id/stroke"
            android:background="@drawable/family_menu_estate_stroke"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_10sdp"
            android:layout_marginRight="@dimen/_20sdp">
            <ImageView
                android:id="@id/level_image"
                android:layout_width="@dimen/_12sdp"
                android:layout_height="@dimen/_12sdp"
                android:layout_marginBottom="@dimen/_6sdp"
                android:scaleType="fitEnd" />
            <TextView
                android:textSize="@dimen/_8sdp"
                android:textColor="@color/white"
                android:id="@id/item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Информация"
                android:fontFamily="@font/pfdindisplaypro_bold" />
            <TextView
                android:textSize="@dimen/_7sdp"
                android:textColor="#ffababab"
                android:id="@id/item_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="Информация о вашей организации"
                android:fontFamily="@font/pfdindisplaypro_regular" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>