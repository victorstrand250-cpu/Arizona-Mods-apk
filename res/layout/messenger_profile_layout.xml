<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.arizona.common.ui.AvatarView
        android:layout_gravity="center"
        android:id="@id/avatar"
        android:layout_width="50.0dip"
        android:layout_height="50.0dip"
        android:layout_marginTop="10.0dip" />
    <TextView
        android:textSize="10.0sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@id/name"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginRight="20.0dip"
        android:text="John Smith"
        android:fontFamily="@font/pfdindisplaypro_regular"
        android:layout_marginHorizontal="20.0dip" />
    <TextView
        android:textSize="10.0sp"
        android:textColor="#ffaaaaaa"
        android:gravity="center"
        android:id="@id/phone"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginRight="20.0dip"
        android:text="712-124"
        android:fontFamily="@font/pfdindisplaypro_regular"
        android:layout_marginHorizontal="20.0dip" />
    <TextView
        android:textSize="10.0sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20.0dip"
        android:layout_marginTop="20.0dip"
        android:layout_marginRight="20.0dip"
        android:text="Выбрать цвет аватарки"
        android:fontFamily="@font/pfdindisplaypro_regular"
        android:layout_marginHorizontal="20.0dip" />
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@id/colors_rv"
        android:paddingLeft="5.0dip"
        android:paddingRight="5.0dip"
        android:paddingBottom="5.0dip"
        android:visibility="visible"
        android:scrollbars="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginRight="5.0dip"
        android:layout_marginHorizontal="5.0dip"
        android:paddingHorizontal="5.0dip"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="6" />
    <LinearLayout
        android:gravity="start|center"
        android:orientation="horizontal"
        android:layout_width="fill_parent"
        android:layout_height="15.0dip"
        android:layout_marginTop="5.0dip"
        android:layout_marginStart="15.0dip">
        <TextView
            android:textSize="10.0sp"
            android:textColor="@color/white"
            android:id="@id/notification_text"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Уведомления"
            android:layout_weight="1.0"
            android:fontFamily="@font/pfdindisplaypro_regular" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@id/notification_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="0.6"
            android:scaleY="0.6"
            app:thumbTint="@color/switch_on_off_messenger_thumb"
            app:trackTint="#ff595959" />
    </LinearLayout>
    <View
        android:background="#ff2f2f2f"
        android:layout_width="fill_parent"
        android:layout_height="1.0dip"
        android:layout_marginLeft="4.0dip"
        android:layout_marginTop="10.0dip"
        android:layout_marginRight="4.0dip"
        android:layout_marginHorizontal="4.0dip" />
</LinearLayout>