<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="15.0sp"
            android:textColor="@color/white"
            android:gravity="start"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15.0dip"
            android:layout_marginTop="10.0dip"
            android:layout_marginRight="15.0dip"
            android:text="Новая переписка"
            android:fontFamily="@font/pfdindisplaypro_regular"
            android:layout_marginHorizontal="15.0dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/add_from_contacts_container"
            android:paddingTop="5.0dip"
            android:paddingBottom="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15.0dip"
            android:layout_marginTop="15.0dip"
            android:layout_marginRight="15.0dip"
            android:layout_marginHorizontal="15.0dip">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="15.0dip"
                android:layout_height="15.0dip"
                android:src="@drawable/ic_add_user_messenger" />
            <TextView
                android:textSize="10.0sp"
                android:textColor="@color/white"
                android:gravity="start|center"
                android:layout_gravity="center"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="Добавить из контактов"
                android:fontFamily="@font/pfdindisplaypro_medium"
                android:layout_marginStart="10.0dip" />
        </LinearLayout>
        <View
            android:background="#ff2f2f2f"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip"
            android:layout_marginLeft="4.0dip"
            android:layout_marginRight="4.0dip"
            android:layout_marginHorizontal="4.0dip" />
        <LinearLayout
            android:orientation="horizontal"
            android:id="@id/find_by_number_container"
            android:paddingTop="5.0dip"
            android:paddingBottom="10.0dip"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15.0dip"
            android:layout_marginTop="5.0dip"
            android:layout_marginRight="15.0dip"
            android:layout_marginHorizontal="15.0dip">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="15.0dip"
                android:layout_height="15.0dip"
                android:src="@drawable/ic_phone_messenger" />
            <TextView
                android:textSize="10.0sp"
                android:textColor="@color/white"
                android:gravity="start|center"
                android:layout_gravity="center"
                android:layout_width="373.0dip"
                android:layout_height="wrap_content"
                android:text="Найти по номеру телефона"
                android:fontFamily="@font/pfdindisplaypro_medium"
                android:layout_marginStart="10.0dip" />
        </LinearLayout>
        <View
            android:background="#ff2f2f2f"
            android:layout_width="fill_parent"
            android:layout_height="1.0dip"
            android:layout_marginLeft="4.0dip"
            android:layout_marginRight="4.0dip"
            android:layout_marginHorizontal="4.0dip" />
    </LinearLayout>
</RelativeLayout>