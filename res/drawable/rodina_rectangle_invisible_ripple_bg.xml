<?xml version="1.0" encoding="utf-8"?>
<ripple
    android:color="@color/rodina_white"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@android:id/mask">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/rodina_white" />
            <corners
                android:topLeftRadius="@dimen/rodina_btn_corner_radius"
                android:topRightRadius="@dimen/rodina_btn_corner_radius"
                android:bottomLeftRadius="@dimen/rodina_btn_corner_radius"
                android:bottomRightRadius="@dimen/rodina_btn_corner_radius" />
        </shape>
    </item>
    <item
        android:id="@android:id/background">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/transparent100" />
        </shape>
    </item>
</ripple>